---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts, getCategory } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const names = [...new Set(posts.map(getCategory))];
  return names.map((name) => ({
    params: { name },
    props: { name, posts: posts.filter((p) => getCategory(p) === name) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={`分类 · ${name}`}>
  <div class="cat-head">
    <h1>{name}</h1>
    <span class="sticker">{posts.length} 篇</span>
    <a class="back" href="/posts/1">← 全部文章</a>
  </div>

  <section class="cards">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</Base>

<style>
  .cat-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 8px 0 30px;
    flex-wrap: wrap;
  }
  .cat-head h1 {
    font-size: 26px;
    font-weight: 700;
  }
  .cat-head .back {
    margin-left: auto;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .cat-head .back:hover {
    color: var(--red);
  }
  .sticker {
    display: inline-block;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    background: var(--yellow);
    color: var(--ink);
    transform: rotate(-1deg);
  }
  .cards {
    display: grid;
    gap: 26px;
  }
</style>
