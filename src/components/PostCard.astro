---
import type { DatedPost } from "../utils/posts";
import { getPostSlug, getCategory } from "../utils/posts";
import { categoryColor } from "../utils/category";
import { estimateReadTime } from "../utils/readtime";
import { formatDate } from "../utils/format";

interface Props {
  post: DatedPost;
}

const { post } = Astro.props;
const category = getCategory(post);
const minutes = estimateReadTime(post.body ?? "");
const href = `/posts/${getPostSlug(post)}`;
---

<a class="card" href={href}>
  <div class="top">
    <span class={`sticker ${categoryColor(category)}`}>{category}</span>
    {post.data.featured && <span class="sticker red">精选</span>}
  </div>
  <h2>{post.data.title}</h2>
  <p class="excerpt">{post.data.description}</p>
  <div class="foot">
    <span>{formatDate(post.data.date)}</span>
    {post.data.updated && <span>更新于 {formatDate(post.data.updated)}</span>}
    <span>{minutes} 分钟</span>
    <span class="open">阅读 →</span>
  </div>
</a>

<style>
  .card {
    display: block;
    border: 3px solid var(--ink);
    background: var(--card);
    box-shadow: var(--shadow);
    padding: 20px 22px 16px;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }
  .top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  h2 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.5;
  }
  .excerpt {
    color: var(--ink-soft);
    font-size: 14px;
    margin-top: 10px;
  }
  .foot {
    display: flex;
    gap: 18px;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 2px dashed var(--ink-soft);
    font-size: 12px;
    color: var(--ink-soft);
    flex-wrap: wrap;
  }
  .foot .open {
    margin-left: auto;
    color: var(--red);
    font-weight: 600;
  }

  .sticker {
    display: inline-block;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--ink);
    white-space: nowrap;
  }
  .sticker.cyan { background: var(--cyan); transform: rotate(-1.5deg); }
  .sticker.pink { background: var(--pink); transform: rotate(1.2deg); }
  .sticker.yellow { background: var(--yellow); transform: rotate(-1deg); }
  .sticker.blue { background: var(--blue); transform: rotate(1deg); }
  .sticker.red { background: var(--red); color: var(--card); transform: rotate(-1.2deg); }
</style>
