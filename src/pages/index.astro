---
import Base from "../layouts/Base.astro";
import { site } from "../config";
import { getPublishedPosts } from "../utils/posts";

// Ticket 03 联调证据：内容管线通后此处显示真实统计；Ticket 06 重写首页时移除
const posts = await getPublishedPosts();
const categories = new Set(posts.map((p) => p.data.category)).size;
---

<Base>
  <section class="hero">
    <p class="sticker">{site.tagline}</p>
    <h1>{site.name}</h1>
    <p class="sub">漫画稿纸风格的开源博客模板 · 脚手架就绪</p>
    <p class="stats">已收录 {posts.length} 篇文章 · {categories} 个分类（内容管线联调中）</p>
  </section>
</Base>

<style>
  .hero {
    padding: 64px 0 24px;
  }
  .sticker {
    display: inline-block;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    background: var(--blue);
    color: var(--ink);
    transform: rotate(-1deg);
  }
  h1 {
    margin-top: 18px;
    font-size: 40px;
    letter-spacing: 0.04em;
  }
  .sub {
    margin-top: 10px;
    color: var(--ink-soft);
  }
  .stats {
    margin-top: 6px;
    font-size: 12px;
    color: var(--ink-soft);
    letter-spacing: 0.03em;
  }
</style>
