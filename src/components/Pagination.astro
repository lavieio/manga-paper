---
interface Props {
  currentPage: number;
  lastPage: number;
}

const { currentPage, lastPage } = Astro.props;

const PAGE_WINDOW = 7;

/** 页码窗口：≤7 页全显；否则 首 … 当前±1 … 尾 */
function pageItems(current: number, last: number): (number | "…")[] {
  if (last <= PAGE_WINDOW) return Array.from({ length: last }, (_, i) => i + 1);
  const items: (number | "…")[] = [1];
  const from = Math.max(2, current - 1);
  const to = Math.min(last - 1, current + 1);
  if (from > 2) items.push("…");
  for (let p = from; p <= to; p++) items.push(p);
  if (to < last - 1) items.push("…");
  items.push(last);
  return items;
}

const pad = (n: number) => String(n).padStart(2, "0");
const items = pageItems(currentPage, lastPage);
---

<nav class="pager" aria-label="分页">
  {
    currentPage > 1 && (
      <a class="pg" href={`/posts/${currentPage - 1}`}>
        ← 上一页
      </a>
    )
  }
  {
    items.map((item) =>
      item === "…" ? (
        <span class="pg dim">…</span>
      ) : item === currentPage ? (
        <span class="pg on" aria-current="page">
          {pad(item)}
        </span>
      ) : (
        <a class="pg" href={`/posts/${item}`}>
          {pad(item)}
        </a>
      ),
    )
  }
  {
    currentPage < lastPage && (
      <a class="pg" href={`/posts/${currentPage + 1}`}>
        下一页 →
      </a>
    )
  }
</nav>

<style>
  .pager {
    display: flex;
    gap: 12px;
    margin: 44px 0 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .pg {
    min-width: 42px;
    padding: 8px 12px;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    border: 2px solid var(--ink);
    background: var(--card);
    box-shadow: 3px 3px 0 var(--ink);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  a.pg:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .pg.on {
    background: var(--red);
    color: var(--card);
  }
  .pg.dim {
    color: var(--ink-soft);
    box-shadow: none;
    border-color: var(--ink-soft);
  }
</style>
