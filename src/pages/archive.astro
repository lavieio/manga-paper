---
import Base from "../layouts/Base.astro";
import { getPublishedPosts, getPostSlug, getCategory } from "../utils/posts";
import { formatMonthDay, getYear } from "../utils/format";
import { estimateReadTime } from "../utils/readtime";

const posts = await getPublishedPosts();

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = getYear(post.data.date);
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const earliest = posts.at(-1);
---

<Base title="归档">
  <div class="page-head">
    <h1>时间轴</h1>
  </div>

  <section class="timeline">
    {
      years.map((year) => (
        <>
          <div class="year">{year}</div>
          {byYear.get(year)!.map((post) => (
            <div class="t-item">
              <span class="date">{formatMonthDay(post.data.date)}</span>
              <h2>
                <a href={`/posts/${getPostSlug(post)}`}>{post.data.title}</a>
              </h2>
              <span class="mins">
                {getCategory(post)} · {estimateReadTime(post.body ?? "")} 分钟
              </span>
            </div>
          ))}
        </>
      ))
    }
  </section>
</Base>

<style>
  .page-head {
    margin: 8px 0 40px;
  }
  .page-head h1 {
    font-size: 30px;
    font-weight: 700;
  }

  .timeline {
    position: relative;
    padding-left: 34px;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 8px;
    bottom: 8px;
    border-left: 3px dashed var(--ink-soft);
  }
  .year {
    position: relative;
    margin: 44px 0 20px;
    font-size: 24px;
    font-weight: 700;
    display: inline-block;
  }
  .year::before {
    content: "";
    position: absolute;
    left: -33px;
    top: 12px;
    width: 16px;
    height: 16px;
    background: var(--red);
    border: 3px solid var(--ink);
    border-radius: 50%;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .t-item {
    position: relative;
    display: grid;
    grid-template-columns: 96px auto 1fr;
    gap: 14px;
    align-items: baseline;
    padding: 12px 0;
  }
  .t-item::before {
    content: "";
    position: absolute;
    left: -30px;
    top: 19px;
    width: 10px;
    height: 10px;
    background: var(--card);
    border: 3px solid var(--ink);
    border-radius: 50%;
    transition: background 0.2s ease;
  }
  .t-item:hover::before {
    background: var(--yellow);
  }
  .t-item .date {
    font-size: 12px;
    color: var(--ink-soft);
  }
  .t-item .mins {
    font-size: 12px;
    color: var(--ink-soft);
    justify-self: end;
  }
  .t-item h2 {
    font-size: 16px;
    font-weight: 600;
  }
  .t-item h2 a:hover {
    color: var(--red);
    border-bottom: 2px solid var(--red);
  }

  @media (max-width: 560px) {
    .t-item {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .t-item .mins {
      justify-self: start;
    }
  }
</style>
