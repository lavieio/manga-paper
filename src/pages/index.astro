---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import FeaturedStack from "../components/FeaturedStack.astro";
import { getPublishedPosts, getCategory } from "../utils/posts";

const RECENT_COUNT = 3;

const posts = await getPublishedPosts();
const featured = posts.filter((p) => p.data.featured);
const recent = posts.filter((p) => !p.data.featured).slice(0, RECENT_COUNT);
const stats = {
  posts: posts.length,
  categories: new Set(posts.map(getCategory)).size,
  tags: new Set(posts.flatMap((p) => p.data.tags)).size,
};
---

<Base>
  {
    featured.length > 1 ? (
      <FeaturedStack posts={featured} />
    ) : featured.length === 1 ? (
      <section class="hero-single" aria-label="精选文章">
        <div class="tag-row">
          <span class="sticker red">{"// 精选"}</span>
        </div>
        <PostCard post={featured[0]} />
      </section>
    ) : null
  }

  <div class="sec-head">
    <span class="sticker yellow">最近更新</span>
    <span class="rule"></span>
  </div>
  <section class="cards">
    {recent.map((post) => <PostCard post={post} />)}
  </section>

  <div class="actions">
    <a class="btn" href="/posts/">查看全部文章 →</a>
  </div>

  <div class="stats" aria-label="站点统计">
    <div class="stat"><b>{stats.posts}</b>篇文章</div>
    <div class="stat"><b>{stats.categories}</b>个分类</div>
    <div class="stat"><b>{stats.tags}</b>枚标签</div>
  </div>
</Base>

<style>
  .hero-single {
    padding: 48px 0 20px;
  }
  .tag-row {
    display: flex;
    gap: 12px;
    margin-bottom: 34px;
  }
  .sec-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 56px 0 22px;
  }
  .sec-head .rule {
    flex: 1;
    height: 3px;
    background: var(--ink);
  }
  .cards {
    display: grid;
    gap: 26px;
  }
  .actions {
    margin-top: 32px;
    display: flex;
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    border: 3px solid var(--ink);
    box-shadow: var(--shadow);
    background: var(--yellow);
    color: var(--ink);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg);
  }
  .btn:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .stats {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 64px 0 30px;
  }
  .stat {
    border: 3px solid var(--ink);
    background: var(--card);
    box-shadow: var(--shadow);
    padding: 10px 18px;
    font-size: 13px;
  }
  .stat b {
    font-size: 20px;
    display: block;
    line-height: 1.3;
  }

  .sticker {
    display: inline-block;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--ink);
  }
  .sticker.red { background: var(--red); color: var(--card); transform: rotate(-1.2deg); }
  .sticker.yellow { background: var(--yellow); transform: rotate(-1deg); }
</style>
